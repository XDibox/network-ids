[Unit]
Description=Network Intrusion Detection System
After=network.target

[Service]
Type=simple
User=root
ExecStart=/home/YOUR_USER/venv-ids/bin/python3 /path/to/IDS/IDS.py -i eth0 --baseline 60
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
